{
  "name": "playlite",
  "version": "1.1.0",
  "description": "Playwright-based browser debugging CLI for AI agents",
  "type": "module",
  "main": "./dist/cli.js",
  "bin": {
    "playlite": "dist/cli.js"
  },
  "scripts": {
    "prebuild": "rm -rf dist",
    "build": "tsc",
    "test": "node --import tsx/esm --test src/**/*.test.ts"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/shitchell/playlite.git"
  },
  "keywords": [
    "playwright",
    "browser",
    "debugging",
    "cli",
    "cdp",
    "ai-agents"
  ],
  "author": "Shaun Mitchell <shaun@shitchell.com>",
  "license": "WTFPL",
  "bugs": {
    "url": "https://github.com/shitchell/playlite/issues"
  },
  "homepage": "https://github.com/shitchell/playlite#readme",
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "commander": "^14.0.3",
    "playwright-core": "^1.58.2",
    "tsx": "^4.21.0"
  },
  "devDependencies": {
    "@types/node": "^25.5.0",
    "typescript": "^5.9.3"
  }
}
